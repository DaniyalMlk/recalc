{
  "name": "recalc",
  "version": "0.1.0",
  "description": "A spreadsheet formula engine in TypeScript: lexer, parser, dependency graph and incremental recalculation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "recalc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "repl": "tsx src/cli.ts",
    "web": "vite --config web/vite.config.ts"
  },
  "keywords": [
    "spreadsheet",
    "formula",
    "parser",
    "dependency-graph",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
