{
  "name": "recalc-formula",
  "version": "0.1.0",
  "description": "A spreadsheet formula engine in TypeScript: lexer, parser, dependency graph and incremental recalculation.",
  "type": "module",
  "license": "MIT",
  "author": "Daniyal",
  "keywords": [
    "spreadsheet",
    "formula",
    "parser",
    "dependency-graph",
    "incremental",
    "recalculation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniyalMlk/recalc.git"
  },
  "bugs": {
    "url": "https://github.com/DaniyalMlk/recalc/issues"
  },
  "homepage": "https://github.com/DaniyalMlk/recalc#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "recalc": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "evidence": "tsx scripts/evidence-main.ts",
    "prepack": "npm run build",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "repl": "tsx src/cli.ts",
    "bench": "tsx bench/recalc.bench.ts",
    "web": "vite --config web/vite.config.ts",
    "bench:whatif": "tsx bench/whatif.bench.ts",
    "docs": "tsx docs/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
